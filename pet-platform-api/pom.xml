<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.shanhai</groupId>
        <artifactId>PetPlatform</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>pet-platform-api</artifactId>
    <name>pet-platform-api</name>
    <description>API 入口模块 — Controller、全局异常处理、配置、Flyway 迁移</description>
    <!-- 打包为可执行 JAR -->
    <packaging>jar</packaging>

    <dependencies>
        <!-- 内部依赖（聚合全部） -->
        <dependency>
            <groupId>com.shanhai</groupId>
            <artifactId>pet-platform-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shanhai</groupId>
            <artifactId>pet-platform-service</artifactId>
        </dependency>
        <dependency>
            <groupId>com.shanhai</groupId>
            <artifactId>pet-platform-infrastructure</artifactId>
        </dependency>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- SpringDoc OpenAPI (Swagger) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- Flyway 数据库迁移 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- Spring Boot Actuator (健康检查) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <!-- ========== 可执行 JAR 构建插件 ========== -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.shanhai.petplatform.api.PetPlatformApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
